[Unit]
Description=RaspTank Cloud Tele-Operation Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/rasptank_teleop/pi_agent
ExecStart=/usr/bin/python3 /home/pi/rasptank_teleop/pi_agent/tank_agent.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

